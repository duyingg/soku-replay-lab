<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SokuReplayLab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ReplayData.cs" />
    <Compile Include="ReplayTiming.cs" />
    <Compile Include="ReplayInterpretation.cs" />
    <Compile Include="ReplayInterpretationRuleCheck.cs" />
    <Compile Include="ComboDetector.cs" />
    <Compile Include="PressureGapDetector.cs" />
    <Compile Include="ReplayInputAligner.cs" />
    <Compile Include="ReplayBranchRunner.cs" />
    <Compile Include="InPlaceBranchRunner.cs" />
    <Compile Include="InPlaceLiveCheck.cs" />
    <Compile Include="EscapeTrial.cs" />
    <Compile Include="EscapeAttemptDetector.cs" />
    <Compile Include="EscapeLiveCheck.cs" />
    <Compile Include="EscapeBatchLiveCheck.cs" />
    <Compile Include="EscapeWorkerGame.cs" />
    <Compile Include="FullReplayLiveCheck.cs" />
    <Compile Include="SnapshotLiveCheck.cs" />
    <Compile Include="MainWindow.cs" />
    <Compile Include="MainWindow.Theme.cs" />
    <Compile Include="MainWindow.Takeover.cs" />
    <Compile Include="MainWindow.Shortcuts.cs" />
    <Compile Include="GameKeyboardFocus.cs" />
    <Compile Include="AppTheme.cs" />
    <Compile Include="MainWindow.StatsView.cs" />
    <Compile Include="MainWindow.CurvesView.cs" />
    <Compile Include="ReplayWorkspace.cs" />
    <Compile Include="GameDiscovery.cs" />
    <Compile Include="DisplayGuard.cs" />
    <Compile Include="GameWindowLease.cs" />
    <Compile Include="GameSurfaceHost.cs" />
    <Compile Include="GameEmbedCheck.cs" />
    <Compile Include="DesktopDiagnostics.cs" />
    <Compile Include="EventCsvExporter.cs" />
    <Compile Include="StatsCsvExporter.cs" />
    <Compile Include="LiveGameReader.cs" />
    <Compile Include="ActionReference.cs" />
    <Compile Include="ActionCatalog.cs" />
    <Compile Include="CardTimeline.cs" />
    <Compile Include="CardArt.cs" />
    <Compile Include="CardNameReference.cs" />
    <Compile Include="StatRules.cs" />
    <Compile Include="ProbeClient.cs" />
    <Compile Include="ProbePreflight.cs" />
    <Compile Include="ProbeLiveCheck.cs" />
    <Compile Include="BranchLiveCheck.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ThemeControls.xaml" LogicalName="SokuReplayLab.ThemeControls.xaml" />
    <Content Include="CardArt.zip" Condition="Exists('CardArt.zip')" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="NativeAttach.exe;NativeProbe.dll" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
